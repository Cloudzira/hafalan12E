<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hafalan 12 E</title>
  
  <!-- Google Fonts & Font Awesome Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    :root {
      --bg-gradient: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
      --primary: #d47a8f;       /* Dusty Rose */
      --primary-dark: #b85b72;  /* Soft Crimson */
      --accent: #f8ecee;        /* Soft Blush Pink */
      --text-main: #3a3335;     /* Deep Soft Charcoal */
      --text-muted: #7d7376;
      --card-bg: rgba(255, 255, 255, 0.85);
      --border-color: #f1e2e5;
      --shadow-soft: 0 10px 30px rgba(212, 122, 143, 0.08);
      --shadow-hover: 0 15px 35px rgba(212, 122, 143, 0.15);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: linear-gradient(135deg, #fff5f7 0%, #fbebf0 50%, #f7f3f6 100%);
      min-height: 100vh;
      color: var(--text-main);
      padding: 30px 15px;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
    }

    /* Header Styling */
    .header {
      text-align: center;
      margin-bottom: 40px;
    }

    .header .subtitle {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: var(--primary-dark);
      font-weight: 600;
      margin-bottom: 8px;
    }

    .header h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2.5rem;
      color: var(--text-main);
      margin-bottom: 12px;
      font-weight: 700;
    }

    .header-divider {
      width: 60px;
      height: 3px;
      background: var(--primary);
      margin: 0 auto;
      border-radius: 2px;
    }

    /* Controls: Search Bar & Info */
    .controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--card-bg);
      backdrop-filter: blur(10px);
      padding: 15px 25px;
      border-radius: 16px;
      border: 1px solid var(--border-color);
      box-shadow: var(--shadow-soft);
      margin-bottom: 30px;
      flex-wrap: wrap;
      gap: 15px;
    }

    .search-box {
      position: relative;
      flex: 1;
      max-width: 400px;
    }

    .search-box i {
      position: absolute;
      left: 15px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--primary);
    }

    .search-box input {
      width: 100%;
      padding: 12px 15px 12px 42px;
      border: 1px solid var(--border-color);
      border-radius: 30px;
      outline: none;
      font-size: 0.95rem;
      background: #ffffff;
      color: var(--text-main);
      transition: all 0.3s ease;
    }

    .search-box input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(212, 122, 143, 0.15);
    }

    .stats-info {
      font-size: 0.9rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    /* Loading Spinner */
    .loading {
      text-align: center;
      padding: 60px 0;
    }

    .spinner {
      display: inline-block;
      width: 45px;
      height: 45px;
      border: 3px solid rgba(212, 122, 143, 0.2);
      border-radius: 50%;
      border-top-color: var(--primary);
      animation: spin 1s infinite linear;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    /* Card Grid */
    .grid-container {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 25px;
    }

    .card {
      background: var(--card-bg);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: var(--shadow-soft);
      padding: 25px;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 5px;
      background: linear-gradient(90deg, var(--accent), var(--primary));
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-hover);
    }

    .card-header {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-bottom: 20px;
      padding-bottom: 15px;
      border-bottom: 1px dashed var(--border-color);
    }

    .avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--accent);
      color: var(--primary-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      font-size: 1.2rem;
      border: 1px solid var(--border-color);
      flex-shrink: 0;
    }

    .student-info h3 {
      font-size: 1.1rem;
      color: var(--text-main);
      font-weight: 600;
      line-height: 1.3;
    }

    .student-info .no-badge {
      font-size: 0.75rem;
      color: var(--primary-dark);
      background: var(--accent);
      padding: 2px 8px;
      border-radius: 10px;
      display: inline-block;
      margin-top: 4px;
      font-weight: 500;
    }

    /* Capaian Item */
    .capaian-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .capaian-item {
      background: rgba(255, 255, 255, 0.6);
      padding: 12px 15px;
      border-radius: 12px;
      border: 1px solid #fceef1;
    }

    .capaian-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-muted);
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .capaian-label i {
      color: var(--primary);
    }

    .capaian-value {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text-main);
    }

    /* Empty state */
    .no-results {
      grid-column: 1 / -1;
      text-align: center;
      padding: 50px;
      color: var(--text-muted);
    }

    @media (max-width: 600px) {
      .header h1 { font-size: 1.8rem; }
      .controls { flex-direction: column; align-items: stretch; }
      .search-box { max-width: 100%; }
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- Header -->
    <header class="header">
      <div class="subtitle">Laporan Akademik & Hafalan</div>
      <h1>Capaian Siswi</h1>
      <div class="header-divider"></div>
    </header>

    <!-- Controls -->
    <div class="controls">
      <div class="search-box">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="searchInput" placeholder="Cari nama siswi..." onkeyup="filterData()">
      </div>
      <div class="stats-info" id="statsInfo">
        Memuat data...
      </div>
    </div>

    <!-- Loading State -->
    <div id="loading" class="loading">
      <div class="spinner"></div>
      <p style="margin-top: 15px; color: var(--text-muted); font-size: 0.9rem;">Menyiapkan data anggun Anda...</p>
    </div>

    <!-- Cards Container -->
    <div id="gridContainer" class="grid-container" style="display: none;"></div>
  </div>

  <script>
    let allData = [];

    window.onload = function() {
      google.script.run
        .withSuccessHandler(renderCards)
        .withFailureHandler(showError)
        .getDataCapaian();
    };

    function renderCards(data) {
      allData = data;
      document.getElementById('loading').style.display = 'none';
      const container = document.getElementById('gridContainer');
      container.style.display = 'grid';
      
      displayFilteredData(allData);
    }

    function displayFilteredData(data) {
      const container = document.getElementById('gridContainer');
      const statsInfo = document.getElementById('statsInfo');
      container.innerHTML = '';

      statsInfo.innerText = `Menampilkan ${data.length} dari ${allData.length} Siswi`;

      if (data.length === 0) {
        container.innerHTML = `
          <div class="no-results">
            <i class="fa-regular fa-folder-open" style="font-size: 2rem; margin-bottom: 10px; color: var(--primary);"></i>
            <p>Data tidak ditemukan</p>
          </div>`;
        return;
      }

      data.forEach(item => {
        // Ambil inisial nama untuk avatar
        const initial = item.nama.charAt(0).toUpperCase();

        const card = document.createElement('div');
        card.className = 'card';
        card.innerHTML = `
          <div class="card-header">
            <div class="avatar">${initial}</div>
            <div class="student-info">
              <h3>${item.nama}</h3>
              <span class="no-badge">No. Urut: ${item.no}</span>
            </div>
          </div>
          <div class="capaian-group">
            <div class="capaian-item">
              <div class="capaian-label">
                <i class="fa-solid fa-bookmark"></i> Capaian Awal
              </div>
              <div class="capaian-value">${item.capaianAwal}</div>
            </div>
            <div class="capaian-item">
              <div class="capaian-label">
                <i class="fa-solid fa-star"></i> Capaian Akhir
              </div>
              <div class="capaian-value">${item.capaianAkhir}</div>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function filterData() {
      const query = document.getElementById('searchInput').value.toLowerCase();
      const filtered = allData.filter(item => 
        item.nama.toLowerCase().includes(query)
      );
      displayFilteredData(filtered);
    }

    function showError(err) {
      document.getElementById('loading').innerHTML = `
        <p style="color: #d9534f;">Gagal memuat data: ${err.message}</p>
      `;
    }
  </script>
</body>
</html>
